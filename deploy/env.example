# Copy to deploy/.env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
# Host ports (containers keep their internal ports)
WEB_PORT=3300
BRAIN_PORT=8300
# Vite dev server (docker compose --profile dev up web-dev)
WEB_DEV_PORT=3301

# Provider API keys (referenced by credential_ref in the providers
# table; leave empty to keep a provider unhealthy/skipped)
ANTHROPIC_API_KEY=
ZAI_API_KEY=
XAI_API_KEY=

# Bearer token for brain's public API (generate: openssl rand -hex 32)
TIMOTHY_API_TOKEN=

# npm auth token for HugeIcons Pro packages (from your hugeicons.com account)
HUGEICONS_TOKEN=
