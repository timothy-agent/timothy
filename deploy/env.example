# Copy to deploy/.env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Ports ---
# Host ports (containers keep their internal ports)
WEB_PORT=3300
BRAIN_PORT=8300
CLIPROXY_PORT=8317
# Vite dev server (docker compose --profile dev up web-dev)
WEB_DEV_PORT=3301

# --- Logging ---
LOG_LEVEL=info

# --- Secrets ---
# Root of trust for the encrypted secret store (generate: openssl rand
# -base64 32). Provider keys and connector credentials entered in
# Settings are encrypted with this; losing it makes stored secrets
# unrecoverable. Shared by gateway and brain.
TIMOTHY_MASTER_KEY=

# Bearer token for brain's public API (generate: openssl rand -hex 32)
TIMOTHY_API_TOKEN=

# Bearer token Prometheus sends when scraping brain's /metrics on the
# published port (generate: openssl rand -hex 32). Empty rejects scrapes.
TIMOTHY_METRICS_TOKEN=

# Public base URL as the browser reaches Timothy, e.g.
# http://localhost:3300 — used for connector OAuth redirects (Google).
# The same URL + /v1/connectors/oauth/callback goes in the OAuth
# client's authorized redirect URIs.
TIMOTHY_PUBLIC_URL=http://localhost:3300

# --- Chat turns ---
# Detached-turn ceiling override (Go duration, e.g. "60m"). Empty
# keeps the compiled 30m default; must exceed 10m (permission park
# timeout). Raise together with a slow provider's request_timeout so
# the two deadlines never collide.
TURN_TIMEOUT=

# --- Workflows ---
# Non-empty enables the agentic workflows layer (orchestration above
# missions). Off by default.
WORKFLOWS_ENABLED=

# --- Ecosystem smoke matrix ---
# Non-empty: mission osv-scanner audits scan the local database in the
# sandbox-caches volume instead of the live API, so counts stay fixed
# for a make canary-ecosystems run. Needs that volume; off by default.
MISSION_OSV_OFFLINE=

# --- Mission sandbox ---
# Group ID of the docker.sock on your host, needed so sandboxd (running
# as a non-root user) can use it. Docker Desktop: 0 (the default)
# works. Linux hosts: run `stat -c '%g' /var/run/docker.sock` and set
# it here if it isn't 0.
DOCKER_SOCK_GID=0

# --- Compose profiles & heavy sidecars (optional) ---
# Timothy defaults to a lightweight core footprint (~300–500 MiB RAM):
# postgres, gateway, memoryd, sandboxd, brain, and web.
# Heavy sidecars are grouped into Compose profiles. To activate a
# profile, specify COMPOSE_PROFILES and set its corresponding URL(s):
#
# Profile 'search' (~512 MiB RAM cap):
#   Metasearch backend for the search_web tool.
#   COMPOSE_PROFILES=search
#   SEARXNG_URL=http://searxng:8080
#
# Profile 'docs' (~6 GiB RAM cap total: markitdown 2g, pdfgen 2g, ocr 2g):
#   Document conversion (PDFs/HTML), markdown-to-PDF export, and local OCR.
#   COMPOSE_PROFILES=docs
#   MARKITDOWN_URL=http://markitdown:8000
#   PDFGEN_URL=http://pdfgen:8000
#   OCR_URL=http://ocr:8000
#
# Profile 'whisper' (~6 GiB RAM cap):
#   Local speech-to-text for the web mic button.
#   COMPOSE_PROFILES=whisper
#   WHISPER_URL=http://whisper:8001
#
# Profile 'full':
#   Activates all sidecars at once.
#   COMPOSE_PROFILES=full
#   SEARXNG_URL=http://searxng:8080
#   MARKITDOWN_URL=http://markitdown:8000
#   PDFGEN_URL=http://pdfgen:8000
#   OCR_URL=http://ocr:8000
#   WHISPER_URL=http://whisper:8001
#
# Profiles can also be comma-separated, e.g. COMPOSE_PROFILES=search,docs

# --- Gateway (optional) ---
# Local-disk directory for failed-provider-attempt request capture
# (debugging only). WARNING: captured files may contain sensitive
# prompt content. Off by default; never enable on a shared host.
# GATEWAY_FAILURE_CAPTURE_DIR=
