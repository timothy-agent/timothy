# Copy to deploy/.env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Ports ---
# Host ports (containers keep their internal ports)
WEB_PORT=3300
BRAIN_PORT=8300
# Vite dev server (docker compose --profile dev up web-dev)
WEB_DEV_PORT=3301

# --- Logging ---
LOG_LEVEL=info

# --- Secrets ---
# Root of trust for the encrypted secret store (generate: openssl rand
# -base64 32). Provider keys entered in Settings are encrypted with
# this; losing it makes stored secrets unrecoverable.
TIMOTHY_MASTER_KEY=

# Bearer token for brain's public API (generate: openssl rand -hex 32)
TIMOTHY_API_TOKEN=

# --- Third-party services ---
# npm auth token for HugeIcons Pro packages (from your hugeicons.com account)
HUGEICONS_TOKEN=
